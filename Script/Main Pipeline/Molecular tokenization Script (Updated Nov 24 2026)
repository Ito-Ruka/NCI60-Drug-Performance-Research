"""
Algortim to indentify functional groups: https://link.springer.com/article/10.1186/s13321-017-0225-z
RDkit Replication of Ertl's algorithm: https://github.com/rdkit/rdkit/tree/master/Contrib/IFG, https://link.springer.com/article/10.1186/s13321-019-0361-8
    - Continued improvemnt to the algorithm: https://pubs.acs.org/jcisd8/article/65/3/1061/3686186/EFGs-A-Complete-and-Accurate-Implementation-of?searchresult=1

Plan:
    - For loop through the NCI60 smiles string list to parse and identify functional groups of the molecule
        - Note: functional group structure needs to be structurally accurate and identical across another moleule containing the same functional gorup.
    - Create a dictionary of total fucntional groups found in the NCI60 smiles string list.
        - Good time to get the stats of the functional groups.
            - drop any functional groups that shows up too few.
    - Assign indexes to each functional group.
    - Go back the the NCI60 SMILES list and apply the functional groups
    - for each functional group, find the atom bonding sites.
"""

#TODO: Reroute import_previous_functional_group_outputs_choice == "y" so it does not need to pass through this function.
def get_and_save_functional_group_data(df_MAIN_DATA, import_previous_functional_group_outputs_choice):

    def find_functional_groups(df_MAIN_DATA):
        # https://pubs.acs.org/jcisd8/article/65/3/1061/3686186/EFGs-A-Complete-and-Accurate-Implementation-of?searchresult=1
        smiles_list = df_MAIN_DATA["SMILES"].dropna().astype(str).unique().tolist()
        
        fg_img_list = {}
        fg_atom_list = {}
        dec_fgs_list = {}
        fg_mol_list = {}

        for smiles in smiles_list:
            mol = Chem.MolFromSmiles(smiles)

            if mol is None:
                fg_img_list[smiles] = None
                fg_atom_list[smiles] = None
                dec_fgs_list[smiles] = None
                fg_mol_list[smiles] = None
                continue

            try:
                fg_img, fg_atom, dec_fgs, fg_mol = get_dec_fgs(mol)
            except Exception as e:
                print(f"Skipping {smiles} due to EFG error: {e}.")
                fg_img_list[smiles] = None
                fg_atom_list[smiles] = None
                dec_fgs_list[smiles] = None
                fg_mol_list[smiles] = None
                continue
            
            fg_img_list[smiles] = fg_img
            fg_atom_list[smiles] = fg_atom
            dec_fgs_list[smiles] = list(dec_fgs) if dec_fgs else []
            fg_mol_list[smiles] = fg_mol
            print(f"Proccessed: {smiles}")

        return fg_img_list, fg_atom_list, dec_fgs_list, fg_mol_list


    def save_functional_group_data(fg_img_list, fg_atom_list, dec_fgs_list, fg_mol_list):
        df_dec_fgs = pd.DataFrame({
            "smiles": list(dec_fgs_list.keys()),
            "functional_groups": list(dec_fgs_list.values())
        })
        df_dec_fgs.to_csv(r"C:\NCI-60 Research\Tokenization\Output_Files\EFG_Output\df_dec_fgs.csv", index=False)
        print("\nExported [df_dec_fgs.csv].")


        df_fg_atom = pd.DataFrame({
            "smiles": list(fg_atom_list.keys()),
            "fg_atom": list(fg_atom_list.values())
        })
        df_fg_atom.to_csv(r"C:\NCI-60 Research\Tokenization\Output_Files\EFG_Output\df_fg_atom.csv", index=False)
        print("\nExported [df_fg_atom.csv].")


        with open(r"C:\NCI-60 Research\Tokenization\Output_Files\EFG_Output\fg_mol.pkl", "wb") as f:
            pickle.dump(fg_mol_list, f)
        print("\nExported [fg_mols.pkl].")

        img_dir = r"C:\NCI-60 Research\Tokenization\Output_Files\EFG_Output\df_img"
        os.makedirs(img_dir, exist_ok = True)
        for idx, (smiles, img_bytes) in enumerate(fg_img_list.items()):
            if img_bytes:
                img_path = os.path.join(img_dir, f"mol_{idx}.png")
                with open(img_path, "wb") as f:
                    f.write(img_bytes)
        return 


    def remaining_frgaments (df_dec_fgs, df_fg_atom):
        
        print("worked")
        return 


    if import_previous_functional_group_outputs_choice == "n":
        fg_img_list, fg_atom_list, dec_fgs_list, fg_mol_list = find_functional_groups(df_MAIN_DATA)
        save_functional_group_data(fg_img_list, fg_atom_list, dec_fgs_list, fg_mol_list)
    
    elif import_previous_functional_group_outputs_choice == "y":
        df_dec_fgs = pd.read_csv(r"C:\NCI-60 Research\Tokenization\Output_Files\EFG_Output\df_dec_fgs.csv")
        df_fg_atom = pd.read_csv(r"C:\NCI-60 Research\Tokenization\Output_Files\EFG_Output\df_fg_atom.csv")

    remaining_frgaments(df_dec_fgs, df_fg_atom)
    
    return 


