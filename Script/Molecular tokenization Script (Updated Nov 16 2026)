def load_functional_group_dict ():
    print("\nLoading dictionary for identifing functional groups.")
    load_dict_choice = str(input(
        "Choose the SMARTS functional group dictionary to use:\n" 
        "[1] RDKit Functional Group Library\n" 
        "[2] Open Babel Library\n"
        "[3] SNART-RX Library"
        "Enter your choice (1/2/3): "
    ))


    def RDKit_functional_group_dict():
        funcitonal_group_list = []

        for name, group in FunctionalGroups.groupDefns.items():
            smarts = group.smarts
            funcitonal_group_list.append({"NAME": name, "SMARTS": smarts })

        df_functional_group_dict = pd.DataFrame(funcitonal_group_list, columns = ["NAME", "SMARTS"])

        num_of_functional_groups = len(df_functional_group_dict)
        print(f"Located {num_of_functional_groups} functional groups.")
        functional_group_id = list(range(1, num_of_functional_groups + 1))
        df_functional_group_dict["ID"] = functional_group_id 
        
        return df_functional_group_dict


    def OpenBabel_functional_group_dict():
        open_babel_dict = open(r"C:\NCI-60 Research\Tokenization\SMARTS_InteLigand.txt").read()
        functional_group_dict = []

        for line in open_babel_dict.splitlines():
            line = line.strip()

            if line == "" or line.startswith("#"):
                continue

            if ":" in line:
                parts = line.split(":", 1)
                name = parts[0].strip()
                smarts = parts[1].strip()

                functional_group_dict.append({"NAME": name, "SMARTS": smarts})

        df_functional_group_dict = pd.DataFrame(functional_group_dict, columns=["NAME", "SMARTS"])

        num_of_functional_groups = len(df_functional_group_dict)
        print(f"Located {num_of_functional_groups} functional groups.")
        functional_group_id = list(range(1, num_of_functional_groups + 1))
        df_functional_group_dict["ID"] = functional_group_id

        return df_functional_group_dict

    def SMART_RX_functional_group_dict ():

        return


    if load_dict_choice == "1":
        print("\nUsing RDKit Functional Group Library.")
        df_functional_group_dict = RDKit_functional_group_dict()
    elif load_dict_choice == "2":
        print("\nUsing Open Babel Library.")
        df_functional_group_dict = OpenBabel_functional_group_dict()
    elif load_dict_choice == "3":
        print("\nUsing SMART-RX Library")
        df_functional_group_dict = SMART_RX_functional_group_dict()

    print(df_functional_group_dict)

    return df_functional_group_dict

def match_functional_groups (df_MAIN_DATA, df_functional_group_dict):
    compiled_functional_groups = []
    matched_results = []
    smiles_list = df_MAIN_DATA["SMILES"].astype(str).tolist()

    for _, row in df_functional_group_dict.iterrows():
        group_id = row["ID"]
        smarts = row["SMARTS"]

        try:
            smarts_obj = pybel.Smarts(smarts)
            compiled_functional_groups.append((group_id, smarts_obj))
        except Exception:
            continue

    for smiles in smiles_list:
        groups_found = []

        try:
            mol = pybel.readstring("smi", smiles)
        except Exception:
            matched_results.append("INVALID_SMILES")
            continue

        for group_id, smarts_obj in compiled_functional_groups:
            matches = smarts_obj.findall(mol)
            if matches:
                groups_found.append(str(group_id))
        group_str = ", ".join(groups_found) if groups_found else "UNSUBSTITUTED"
        matched_results.append(group_str)

    df_MAIN_DATA["MATCHED_GROUPS"] = matched_results
    return df_MAIN_DATA

def tokenization_execution_script (df_MAIN_DATA):
    df_functional_group_dict = load_functional_group_dict()

    df_functional_group_dict_export_choice = input(
                "\n[Optional]: Export df_functional_group_dict"
                "\nEnter (y/n): "
            )
    if df_functional_group_dict_export_choice == "y":
        df_functional_group_dict.to_csv(r"C:\NCI-60 Research\Tokenization\df_functional_group_dict", index=False)
        print("Exported data frame.")
    else:
        print("Proceeding forward.")

    
    df_MAIN_DATA = match_functional_groups(df_MAIN_DATA, df_functional_group_dict)
    print(df_MAIN_DATA.head(5))


    df_MAIN_DATA_export_choice = input(
                "\n[Optional]: Export df_MAIN_DATA"
                "\nEnter (y/n): "
            )
    if df_MAIN_DATA_export_choice == "y":
        df_MAIN_DATA.to_csv(r"C:\NCI-60 Research\Tokenization\df_MAIN_DATA", index=False)
        print("Exported data frame.")
    else:
        print("Proceeding forward.")
    return
