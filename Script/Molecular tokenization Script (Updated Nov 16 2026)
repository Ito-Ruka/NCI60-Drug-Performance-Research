import pandas as pd
import numpy as np
from rdkit import Chem
from rdkit.Chem.SaltRemover import SaltRemover
from rdkit.Chem import Descriptors
import matplotlib.pyplot as plt
import seaborn as sns
from openbabel import pybel
from rdkit.Chem import FunctionalGroups
import os
from rdkit.Chem import Draw



def import_input_data():
    df_DOSERESP = pd.read_csv(r"C:\NCI-60 Research\Input_Data\DOSERESP.csv")
    df_NCI60_SMILES = pd.read_csv(r"C:\NCI-60 Research\Input_Data\nsc_smiles.csv")
    df_doubling = pd.read_csv(r"C:\NCI-60 Research\Input_Data\NCI-60_Cell_Line_Doubling_Times.csv")
    return df_DOSERESP, df_NCI60_SMILES, df_doubling



def remove_non_M_units(df_DOSERESP):
    unit = "M"
    df_DOSERESP = df_DOSERESP[df_DOSERESP["CONCENTRATION_UNIT"] == unit].copy()
    return df_DOSERESP



def convert_to_viability(df_DOSERESP, df_doubling):
    df_doubling = df_doubling.set_index("CELL_NAME")
    doubling_time = df_doubling["Doubling Time (hours)"]
    td = df_DOSERESP["CELL_NAME"].map(doubling_time)
    pg = df_DOSERESP["AVERAGE_GIPRCNT"]
    
    G = 2**(48/td)

    viability_values = []
    
    for p, growth_factor in zip(pg, G):
        if pd.isna(p) or pd.isna(growth_factor):
            viability_values.append(np.nan)
        
        elif p >= 0:
            val = (((p / 100.0) * (growth_factor - 1.0)) + 1.0) / growth_factor
            viability_values.append(val)
        
        else:
            val = ((p / 100.0) + 1.0) / growth_factor
            viability_values.append(val)
    
    df_DOSERESP["VIABILITY"] = viability_values

    return df_DOSERESP



def aggregate_experimental_duplicates (df_DOSERESP):
    group = ["NSC", "CONCENTRATION", "CELL_NAME"]
    duplicates = df_DOSERESP.duplicated(subset = group, keep = False)
    
    df_duplicates = df_DOSERESP[duplicates]
    df_uniques = df_DOSERESP[~duplicates]

    df_aggregated = df_duplicates.groupby(group, as_index = False)["VIABILITY"].median()
    df_uniques = df_uniques[group + ["VIABILITY"]]
    
    df_DOSERESP = (pd.concat([df_uniques, df_aggregated], ignore_index = True))

    return df_DOSERESP, df_duplicates, df_uniques



def available_cell_lines(df_DOSERESP):
    cell_line_options = (df_DOSERESP["CELL_NAME"].value_counts().reset_index())
    cell_line_options.columns = ["CELL_NAME", "COUNT"]
    return cell_line_options



def select_cell_line(df_DOSERESP, cell_line_input):
    df_DOSERESP = df_DOSERESP[df_DOSERESP["CELL_NAME"] == cell_line_input].reset_index(drop = True)
    return df_DOSERESP



def analyze_conc_distribution(df_DOSERESP):
    conc_distribution = df_DOSERESP["CONCENTRATION"].value_counts()
    return conc_distribution



def drop_invalid_conc (df_DOSERESP, selected_conc_list):
    required_concs = list(selected_conc_list)
    expected_count = len(required_concs)

    df_filtered = df_DOSERESP[df_DOSERESP["CONCENTRATION"].isin(required_concs)].copy()
    points_per_curve = df_filtered.groupby(["NSC", "CELL_NAME"])["CONCENTRATION"].transform("nunique")
    df_DOSERESP = df_filtered[points_per_curve == expected_count].copy()
    return df_DOSERESP



def invalid_SMILES_filter (df_NCI60_SMILES):
    invalid_smiles = []

    for index, smiles in df_NCI60_SMILES["SMILES"].items():
        if not isinstance(smiles, str) or Chem.MolFromSmiles(smiles) is None:
            invalid_smiles.append(index)
            print(f"Complelted verification for: {smiles}\n")
    
    df_NCI60_SMILES.drop(index = invalid_smiles, inplace = True)
    df_NCI60_SMILES.reset_index(drop = True, inplace = True)
    return df_NCI60_SMILES, invalid_smiles



def remove_salt(df_NCI60_SMILES):
    remover = SaltRemover()

    for idx, row in df_NCI60_SMILES.iterrows():
        smiles = row["SMILES"]
        mol = Chem.MolFromSmiles(smiles)

        if mol is not None:
            stripped = remover.StripMol(mol, dontRemoveEverything = True)
            df_NCI60_SMILES.at[idx, "SMILES"] = Chem.MolToSmiles(stripped)
    
    return df_NCI60_SMILES



def canonicalize_smiles_string (df_NCI60_SMILES, isomericSmiles):
    smiles_list = df_NCI60_SMILES["SMILES"].astype(str).tolist()
    canonicalized_smiles_list = []
    
    for smiles in smiles_list:
        mol = Chem.MolFromSmiles(smiles)
        if mol is None:
            return None
        else:
            canonicalized_smiles_list.append(Chem.MolToSmiles(mol, isomericSmiles = isomericSmiles))
        print(f"Canonicalized: {smiles}")
        
    df_NCI60_SMILES["SMILES"] = canonicalized_smiles_list
    return df_NCI60_SMILES



def mol_weight_filter(df_NCI60_SMILES, df_DOSERESP):
    
    def get_mol_weight(df_NCI60_SMILES):
        nsc_list = df_NCI60_SMILES["NSC"].tolist()
        smiles_list = df_NCI60_SMILES["SMILES"].astype(str).tolist()
        mol_weight_list = []
        
        for smiles in smiles_list:
            mol = Chem.MolFromSmiles(smiles) 
            if mol is None:
                mol_weight_list.append(None)
            else:
                mol_weight_list.append(Descriptors.MolWt(mol))
                print(f"Completed calculating molecular weight for: {smiles}.")

        df_NCI60_SMILES_MOL_WEIGHT = pd.DataFrame()
        df_NCI60_SMILES_MOL_WEIGHT["NSC"] = nsc_list
        df_NCI60_SMILES_MOL_WEIGHT["NSC"] = df_NCI60_SMILES_MOL_WEIGHT["NSC"].astype("int64")
        df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"] = mol_weight_list
        df_NCI60_SMILES_MOL_WEIGHT = df_NCI60_SMILES_MOL_WEIGHT.dropna(subset=["MOL_WEIGHT"]).reset_index(drop=True)
        return df_NCI60_SMILES_MOL_WEIGHT



    def plot_mol_weight(df_DOSERESP, df_NCI60_SMILES_MOL_WEIGHT):
        q25 = df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"].quantile(0.25)
        q75 = df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"].quantile(0.75)
        iqr = q75 - q25
        lower_bound = q25 - (1.5 * iqr)
        upper_bound = q75 + (1.5 * iqr)

        df_plot_data = pd.merge(df_DOSERESP, df_NCI60_SMILES_MOL_WEIGHT[["NSC", "MOL_WEIGHT"]], on="NSC", how="inner")
        df_plot_data["IS_OUTLIER"] = (df_plot_data["MOL_WEIGHT"] < lower_bound) | (df_plot_data["MOL_WEIGHT"] > upper_bound)

        plt.figure(figsize=(15, 10))
        sns.scatterplot(
            data=df_plot_data,
            x="MOL_WEIGHT",
            y="VIABILITY",
            hue="IS_OUTLIER",
            palette={False: "blue", True: "red"},
            alpha=0.6,
            s=30
        )

        plt.title("Molecular Weight vs. Viability (Showing Data Point IQR)")
        plt.xlabel("Molecular Weight (g/mol)")
        plt.ylabel("Viability")
        plt.tight_layout()
        plt.show()



    def mol_weight_filter (df_NCI60_SMILES_MOL_WEIGHT):
        #TODO: Potential bug: if you enter "n", then crash.
        mol_weight_filter_choice = input(
            "\nProceed to filter SMILES srings with respect to molecular weight?" 
            "\nEnter (y/n): "
        )
        
        if mol_weight_filter_choice == "y":
            method = input(
                "\nSelect method of filtration: [1] IQR Filter or [2] Cutoff Range" 
                "\nEnter (1/2): "
            ).strip()

            if method == "1":
                print("\nProceeding with IQR.")
                q25 = df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"].quantile(0.25)
                q75 = df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"].quantile(0.75)
                iqr = q75 - q25

                lower_bound = q25 - (1.5 * iqr)
                upper_bound = q75 + (1.5 * iqr)

            elif method == "2":
                print("\nProceeding with range selection.")
                print("Recomended deafult settings: (0, 1000)")
                lower_bound = float(input("Enter minimum molecular weight (g/mol): ").strip())
                upper_bound = float(input("Enter maximum molecular weight (g/mol): ").strip())
        
            bound_filtering_result = (df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"] >= lower_bound) & (df_NCI60_SMILES_MOL_WEIGHT["MOL_WEIGHT"] <= upper_bound)
            print(f"\nCutoff bounds: [{lower_bound:.2f}, {upper_bound:.2f}] g/mol")

            df_mol_weight_outliers = df_NCI60_SMILES_MOL_WEIGHT[~bound_filtering_result].reset_index(drop=True)
            df_NCI60_SMILES_MOL_WEIGHT = df_NCI60_SMILES_MOL_WEIGHT[bound_filtering_result].reset_index(drop=True)
            print(
                f"\nRetained {len(df_NCI60_SMILES_MOL_WEIGHT)} compounds." 
                f"\nDropped {len(df_mol_weight_outliers)} outliers."
            )
        
        else:
            print("\nProceeding forward.")

        return df_NCI60_SMILES_MOL_WEIGHT, df_mol_weight_outliers

    df_NCI60_SMILES_MOL_WEIGHT = get_mol_weight(df_NCI60_SMILES)
    plot_mol_weight(df_DOSERESP, df_NCI60_SMILES_MOL_WEIGHT)
    df_NCI60_SMILES_MOL_WEIGHT, df_mol_weight_outliers = mol_weight_filter(df_NCI60_SMILES_MOL_WEIGHT)
    return df_NCI60_SMILES_MOL_WEIGHT



def merge_data_frames (df_DOSERESP, df_NCI60_SMILES, df_NCI60_SMILES_MOL_WEIGHT):
    df_MAIN_DATA = pd.DataFrame()
    df_MAIN_DATA = pd.merge(df_DOSERESP, df_NCI60_SMILES, on = "NSC", how = "inner")
    df_MAIN_DATA = df_MAIN_DATA.dropna().reset_index(drop=True)

    df_MAIN_DATA = pd.merge(df_MAIN_DATA, df_NCI60_SMILES_MOL_WEIGHT[["NSC", "MOL_WEIGHT"]], on="NSC", how="inner")
    df_MAIN_DATA = df_MAIN_DATA.dropna().reset_index(drop=True)
    df_MAIN_DATA = df_MAIN_DATA.drop(columns = "MOL_WEIGHT")

    df_MAIN_DATA = df_MAIN_DATA.sort_values(by = ["NSC", "CONCENTRATION"]).reset_index(drop = True)

    return df_MAIN_DATA



def visual_check_render(df_MAIN_DATA):
    df_MAIN_DATA["SMILES"] = df_MAIN_DATA["SMILES"].apply(lambda x: x[0] if isinstance(x, tuple) else str(x))

    smiles_to_render = df_MAIN_DATA["SMILES"].unique().tolist()
    nsc_to_render = df_MAIN_DATA["NSC"].unique().tolist()

    output_dir = (r"C:\NCI-60 Research\Tokenization\analyzing_substructures_output_data\rendered 2D png")
    os.makedirs(output_dir, exist_ok = True)

    for smile, nsc in zip(smiles_to_render, nsc_to_render):
        mol = Chem.MolFromSmiles(smile)
        if mol is None:
            continue
        
        Chem.rdDepictor.Compute2DCoords(mol)

        img = Draw.MolToImage(mol, size = (1000, 1000))

        file_name = os.path.join(output_dir, f"NSC_{nsc}.png")
        img.save(file_name)
    return



